amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"

exclude = List("pnpm-lock.yaml")

local linters = new Mapping {
    ["ox_lint"] = (Builtins.ox_lint) {
        prefix = List("pnpm", "exec")
    }
    ["oxfmt"] = (Builtins.oxfmt) {
        prefix = List("pnpm", "exec")
    }
    ["tsc"] = (Builtins.tsc) {
        check = "pnpm typecheck"
    }
    ["just_format"] = (Builtins.just_format) {
        check = "xargs -I {} -- just --fmt --check --unstable --justfile {}"
        fix = "xargs -I {} -- just --fmt --unstable --justfile {}"
    }
    ["jscpd"] = new Step {
        glob = List("**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}")
        check = "pnpm jscpd"
    }
    ["knip"] = (Builtins.knip) {
        check = "pnpm knip --no-progress"
        fix = null
    }
}

steps = linters

hooks {
    ["pre-commit"] {
        steps = (linters) {
            ["gitleaks"] = (Builtins.gitleaks) {
                scan = "staged"
            }
            ["vitest"] {
                glob = List("**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}")
                check = "pnpm exec vitest related --run --passWithNoTests {{files}}"
            }
        }
    }
    ["commit-msg"] {
        steps {
            ["commitlint"] {
                check = "pnpm exec commitlint --edit {{commit_msg_file}}"
            }
        }
    }
}
