{
	"name": "obsidian-reading-annotation",
	"version": "0.1.0",
	"description": "Annotate text while reading with structured reaction types for Obsidian",
	"keywords": [],
	"license": "0-BSD",
	"type": "module",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "pnpm typecheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"lint": "oxlint",
		"check": "pnpm lint && oxfmt --check .",
		"fix": "oxlint --fix && oxfmt .",
		"knip": "knip",
		"jscpd": "jscpd .",
		"mutation": "stryker run"
	},
	"dependencies": {
		"obsidian": "latest"
	},
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@commitlint/cli": "^20.5.0",
		"@commitlint/config-conventional": "^20.5.0",
		"@commitlint/types": "20.5.0",
		"@stryker-mutator/core": "10.0.0",
		"@stryker-mutator/vitest-runner": "10.0.0",
		"@types/node": "^16.11.6",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.1.9",
		"jscpd": "5.3.1",
		"jsdom": "^29.0.1",
		"knip": "6.37.0",
		"oxfmt": "0.70.0",
		"oxlint": "1.85.0",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"vitest": "^4.1.2"
	},
	"packageManager": "pnpm@12.8.1"
}
