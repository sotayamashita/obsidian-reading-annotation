{
	"name": "obsidian-reading-annotation",
	"version": "0.1.0",
	"description": "Annotate text while reading with structured reaction types for Obsidian",
	"keywords": [],
	"license": "0-BSD",
	"type": "module",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "vitest run",
		"lint": "eslint .",
		"prepare": "husky"
	},
	"dependencies": {
		"obsidian": "latest"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.5.0",
		"@commitlint/config-conventional": "^20.5.0",
		"@eslint/js": "9.30.1",
		"@secretlint/secretlint-rule-preset-recommend": "^11.4.1",
		"@types/node": "^16.11.6",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"husky": "^9.1.7",
		"jiti": "2.6.1",
		"nano-staged": "^0.9.0",
		"oxfmt": "^0.43.0",
		"secretlint": "^11.4.1",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1",
		"vitest": "^4.1.2"
	}
}
